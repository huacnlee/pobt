---
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';
import { copy, POB, REPO, ZIP, type Language } from '../lib/copy';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = copy[language];
const base = import.meta.env.BASE_URL;
const site = new URL(base, Astro.site);
const scriptUrl = new URL('install.ps1', site).href;
const command = `irm ${scriptUrl} | iex`;
const other: Language = language === 'en' ? 'zh-CN' : 'en';
const otherHref = other === 'en' ? base : `${base}zh-CN/`;
const otherName = other === 'en' ? 'English' : '简体中文';
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" hreflang="en" href={new URL(base, Astro.site).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`${base}zh-CN/`, Astro.site).href} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header>
      <div class="shell nav-row">
        <a class="brand" href={language === 'en' ? base : `${base}zh-CN/`}>
          <img src={`${base}favicon.svg`} width="30" height="30" alt="" />
          <span>POBT</span>
        </a>
        <nav aria-label="Primary">
          <a href="#download">{t.nav.download}</a>
          <a href="#install">{t.nav.install}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={REPO} rel="noopener">{t.nav.github}</a>
          <a class="lang" href={otherHref} hreflang={other} lang={other} aria-label={t.nav.language}>{otherName}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="shell hero" id="download">
        <div class="hero-text">
          <p class="eyebrow">{t.eyebrow}</p>
          <h1><span>{t.heading[0]}</span> <span class="gold">{t.heading[1]}</span></h1>
          <div class="divider" aria-hidden="true"><span></span></div>
          <p class="intro">{t.intro}</p>
          <div class="actions">
            <a class="poe-button primary" href={ZIP}>
              <span>{t.download}</span>
            </a>
            <a class="text-link" href="#script">{t.scriptLink}</a>
          </div>
          <p class="note">{t.downloadNote}</p>
        </div>

        <aside class="tooltip" aria-label={t.tooltip.name}>
          <div class="tooltip-header">
            <span class="tooltip-name">{t.tooltip.name}</span>
            <span class="tooltip-base">{t.tooltip.base}</span>
          </div>
          <div class="tooltip-body">
            <p class="implicit">{t.tooltip.implicit}</p>
            <hr />
            {t.tooltip.mods.map((m) => <p class="mod">{m}</p>)}
            <hr />
            <p class="flavour">{t.tooltip.flavour}</p>
          </div>
        </aside>
      </section>

      <section class="shell section" id="install">
        <div class="section-heading">
          <h2>{t.installTitle}</h2>
          <p>{t.installIntro}</p>
        </div>
        <ol class="steps">
          {
            t.steps.map(([title, body], i) => (
              <li class="panel">
                <span class="step-number">{['I', 'II', 'III', 'IV'][i]}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="shell section split" id="script">
        <div class="section-heading">
          <h2>{t.scriptTitle}</h2>
          <p>{t.scriptIntro}</p>
        </div>
        <div>
          <div class="command panel">
            <pre><code id="command">{command}</code></pre>
            <button class="poe-button small" type="button" data-copy="command" data-copied={t.copied}>{t.copy}</button>
          </div>
          <a class="text-link script-link" href={`${base}install.ps1`}>{t.readScript}</a>
        </div>
      </section>

      <section class="shell section split">
        <div class="section-heading">
          <h2>{t.requireTitle}</h2>
        </div>
        <ul class="requirements">
          {t.requirements.map((r, i) => <li>{i === 1 ? <a href={POB} rel="noopener">{r}</a> : r}</li>)}
        </ul>
      </section>

      <section class="shell section" id="faq">
        <div class="section-heading">
          <h2>{t.faqTitle}</h2>
        </div>
        <div class="faq">
          {
            t.faq.map(([q, a]) => (
              <details class="panel">
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="shell section">
        <div class="section-heading">
          <h2>{t.creditsTitle}</h2>
        </div>
        <ul class="credits">
          {
            t.credits.map(([name, what, href]) => (
              <li class="panel">
                <a href={href} rel="noopener">{name}</a>
                <p>{what}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer>
      <div class="shell">
        <p>
          {t.footer} <a class="text-link" href={REPO} rel="noopener">GitHub</a>
        </p>
        <p class="trademark">{t.trademark}</p>
      </div>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy!)?.textContent ?? '';
          const label = button.textContent;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = button.dataset.copied ?? label;
            setTimeout(() => (button.textContent = label), 1600);
          } catch {}
        });
      }
    </script>
  </body>
</html>
