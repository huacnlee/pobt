---
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '../styles/global.css';
import { copy, POB, REPO, SHOT, SPONSOR, ZIP, type Language } from '../lib/copy';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const t = copy[language];
const base = import.meta.env.BASE_URL;
const site = new URL(base, Astro.site);
const scriptUrl = new URL('install.ps1', site).href;
const command = `irm ${scriptUrl} | iex`;
const unixCommand = `curl -fsSL ${new URL('install.sh', site).href} | bash`;
const other: Language = language === 'en' ? 'zh-CN' : 'en';
const otherHref = other === 'en' ? base : `${base}zh-CN/`;
const otherName = other === 'en' ? 'English' : '简体中文';
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="alternate" hreflang="en" href={new URL(base, Astro.site).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`${base}zh-CN/`, Astro.site).href} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header>
      <div class="shell nav-row">
        <a class="brand" href={language === 'en' ? base : `${base}zh-CN/`}>
          <img src={`${base}favicon.png`} width="40" height="40" alt="" />
          <span>POBT</span>
        </a>
        <nav aria-label="Primary">
          <a href={REPO} rel="noopener">{t.nav.github}</a>
          <i aria-hidden="true">◆</i>
          <a class="sponsor-link" href={SPONSOR} rel="noopener">♥ {t.nav.sponsor}</a>
          <a class="plaque dark small lang" href={otherHref} hreflang={other} lang={other} aria-label={t.nav.language}><span>{otherName}</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="download">
        <div class="backdrop" id="backdrop" aria-hidden="true"><canvas></canvas><canvas></canvas></div>
        <div class="gate" aria-hidden="true"></div>
        <div class="beam" aria-hidden="true"></div>
        <div class="shell hero-text">
          <h1><img src={`${base}ui/title.png`} width="760" height="105" alt="Path of Building" /></h1>
          <div class="rule" aria-hidden="true"><span></span></div>
          <p class="subtitle">{t.subtitle}</p>
          <p class="intro">{t.intro}</p>
          <a class="plaque red big" href={ZIP}><span>{t.download}</span></a>
          <p class="note">{t.downloadNote}</p>
          <a class="text-link" href="#script">{t.scriptLink}</a>
        </div>
      </section>

      <section class="shell shot">
        <figure>
          <img src={SHOT} width="1924" height="1276" alt={t.shotAlt} loading="lazy" />
        </figure>
        <div class="shots">
          {t.shots.map((s) => <img src={s.src} width="1924" height="1276" alt={s.alt} loading="lazy" />)}
        </div>
        <figure class="ai-shot">
          <img src={t.shotAi.src} width="1924" height="1276" alt={t.shotAi.alt} loading="lazy" />
        </figure>
      </section>

      <section class="shell section">
        <div class="section-heading">
          <h2>{t.featuresTitle}</h2>
        </div>
        <ul class="features">
          {t.features.map((f) => <li class="card">{f}</li>)}
        </ul>
      </section>

      <section class="shell section" id="characters">
        <div class="section-heading">
          <h2>{t.charactersTitle}</h2>
          {t.charactersText.map((line) => <p>{line}</p>)}
        </div>
        <figure class="characters-shot">
          <img src={`${base}screenshot-characters.png`} width="1924" height="1234" alt={t.shotCharactersAlt} loading="lazy" />
        </figure>
      </section>

      <section class="shell section" id="performance">
        <div class="section-heading">
          <h2>{t.perfTitle}</h2>
          <p>{t.perfIntro}</p>
        </div>
        <div class="perf card">
          <table>
            <thead>
              <tr>{t.perfHead.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {
                t.perfRows.map(([metric, pobt, pob]) => (
                  <tr>
                    <th scope="row">{metric}</th>
                    <td>{pobt}</td>
                    <td>{pob}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="perf-note">{t.perfNote}</p>
      </section>

      <section class="shell section" id="install">
        <div class="section-heading">
          <h2>{t.installTitle}</h2>
          <p>{t.installIntro}</p>
        </div>
        <ol class="steps">
          {
            t.steps.map(([title, body], i) => (
              <li class="card">
                <span class="step-number">{['I', 'II', 'III', 'IV'][i]}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="shell section split" id="script">
        <div class="section-heading">
          <h2>{t.scriptTitle}</h2>
          <p>{t.scriptIntro}</p>
        </div>
        <div>
          <div class="command card">
            <pre><code id="command">{command}</code></pre>
            <button class="plaque brass small" type="button" data-copy="command" data-copied={t.copied}><span>{t.copy}</span></button>
          </div>
          <a class="text-link script-link" href={`${base}install.ps1`}>{t.readScript}</a>
        </div>
      </section>

      <section class="shell section split" id="unix">
        <div class="section-heading">
          <h2>{t.unixTitle}</h2>
          <p>{t.unixIntro}</p>
        </div>
        <div>
          <div class="command card">
            <pre><code id="unix-command">{unixCommand}</code></pre>
            <button class="plaque brass small" type="button" data-copy="unix-command" data-copied={t.copied}><span>{t.copy}</span></button>
          </div>
          <p class="perf-note">{t.unixNote}</p>
          <a class="text-link script-link" href={`${base}install.sh`}>{t.readScript}</a>
        </div>
      </section>

      <section class="shell section split">
        <div class="section-heading">
          <h2>{t.requireTitle}</h2>
        </div>
        <ul class="requirements">
          {t.requirements.map((r, i) => <li>{i === 1 ? <a href={POB} rel="noopener">{r}</a> : r}</li>)}
        </ul>
      </section>

      <section class="shell section" id="faq">
        <div class="section-heading">
          <h2>{t.faqTitle}</h2>
        </div>
        <div class="faq">
          {
            t.faq.map(([q, a]) => (
              <details class="card">
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="shell section sponsor" id="sponsor">
        <div class="section-heading">
          <h2>{t.sponsorTitle}</h2>
          <p>{t.sponsorIntro}</p>
        </div>
        <a class="plaque red" href={SPONSOR} rel="noopener"><span>♥ {t.sponsorButton}</span></a>
      </section>

      <section class="shell section">
        <div class="section-heading">
          <h2>{t.creditsTitle}</h2>
        </div>
        <ul class="credits">
          {
            t.credits.map(([name, what, href]) => (
              <li class="card">
                <a href={href} rel="noopener">{name}</a>
                <p>{what}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer>
      <div class="shell foot-row">
        <nav aria-label="Links">
          <a href="https://poe.ninja" rel="noopener">poe.ninja</a>
          <i aria-hidden="true">◆</i>
          <a href={POB} rel="noopener">POB</a>
          <i aria-hidden="true">◆</i>
          <a href={REPO} rel="noopener">GitHub</a>
          <i aria-hidden="true">◆</i>
          <a class="sponsor-link" href={SPONSOR} rel="noopener">♥ {t.nav.sponsor}</a>
        </nav>
        <p>{t.footer}</p>
      </div>
      <p class="shell trademark">{t.trademark}</p>
    </footer>

    <script>
      import { startGate } from '../scripts/gate';
      const backdrop = document.getElementById('backdrop');
      if (backdrop) startGate(backdrop).catch((e) => { backdrop.dataset.error = String(e); console.warn('backdrop:', e); });
    </script>
    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy!)?.textContent ?? '';
          const label = button.querySelector('span')!;
          const text0 = label.textContent;
          try {
            await navigator.clipboard.writeText(text);
            label.textContent = button.dataset.copied ?? text0;
            setTimeout(() => (label.textContent = text0), 1600);
          } catch {}
        });
      }
    </script>
  </body>
</html>
