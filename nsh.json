{
  "name": "POBT",
  "id": "com.huacnlee.pobt",
  "icon": "icon.png",
  "version": "0.5.2",
  "build": 1,
  "updater": {
    "github": "huacnlee/pobt"
  },
  "appearance": "dark",
  "window": {
    "title": "POBT",
    "defaultSize": {
      "width": 1280,
      "height": 820
    },
    "minSize": {
      "width": 960,
      "height": 640
    }
  },
  "rust": "ext/pobt-native",
  "theme": "theme.json",
  "dependencies": {
    "nsh-icon": "^0.2.2",
    "nsh-icon-lucide": "^0.2.1"
  },
  "capabilities": {
    "network": {
      "hosts": [
        "poe.ninja",
        "web.poecdn.com"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "application": true,
    "notifications": true,
    "clipboard": true,
    "homeDir": true,
    "fs": {
      "read": [
        "${homeDir}",
        "${dataDir}"
      ],
      "write": [
        "${homeDir}",
        "${dataDir}"
      ]
    }
  }
}
